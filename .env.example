APP_NAME=RazorShield
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://razorshield:razorshield@localhost:5432/razorshield
CORS_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=false
LOG_LEVEL=INFO
# Required in production only; use a secure value of at least 32 characters.
# SECRET_KEY=
# Render supplies PORT and DATABASE_URL. Set production values as:
# ENVIRONMENT=production
# DATABASE_URL=postgresql://... (normalized to the bundled psycopg v3 driver)
# CORS_ORIGINS=["https://your-project.vercel.app"]
# VITE_API_BASE_URL is configured in Vercel, not in this backend file.
